<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE=YES). Declares the .fd808 beat archive
	     so a shared file offers "Open in FD-808" and RootView.onOpenURL can import it (SYSTEMS_GAP_AUDIT #export-8). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>FD-808 Beat</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.blkmkt.fd808.beat</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.blkmkt.fd808.beat</string>
			<key>UTTypeDescription</key>
			<string>FD-808 Beat</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fd808</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- Supabase endpoint, overridable at build time so the project ref / publishable key can rotate
	     without an app release. SyncConfig reads these and falls back to its dev literals when the
	     values are still the $(…) placeholders (RELEASE_AUDIT finding 1). Set FD_SUPABASE_PROJECT_REF /
	     FD_SUPABASE_ANON_KEY as build settings (or in CI) to point a build at another project. -->
	<key>FDSupabaseProjectRef</key>
	<string>$(FD_SUPABASE_PROJECT_REF)</string>
	<key>FDSupabaseAnonKey</key>
	<string>$(FD_SUPABASE_ANON_KEY)</string>
</dict>
</plist>
